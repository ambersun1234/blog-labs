datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
    engineType    = "binary"
}

model User {
    id         Int      @id @default(autoincrement())
    username   String   @unique(map: "si_username_key")
    created_at DateTime @default(now())

    @@index([username, id], map: "ci_username_id_key")
}

model Post {
    id         Int      @id @default(autoincrement())
    postname   String   @unique(map: "si_postname_key")
    created_at DateTime @default(now())
}
